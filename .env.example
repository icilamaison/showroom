# PostgreSQL
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Express
SERVER_PORT=4000
NODE_ENV=production

# JWT (배포 시 반드시 새 랜덤값으로 교체: openssl rand -base64 48)
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# 최초 관리자 계정 (npm run db:seed 실행 시 생성)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=change-me

# CORS (Vercel 배포 주소)
CLIENT_ORIGIN=https://showroom-olive.vercel.app

# 비즈고 (알림톡·문자) - 키는 .env에만 넣고 커밋 금지
# 샌드박스 테스트 시 https://sandbox-mars.ibapi.kr
BIZGO_BASE_URL=https://mars.ibapi.kr
BIZGO_API_KEY=
# 카카오 발신프로필 키
BIZGO_SENDER_KEY=
BIZGO_ALIMTALK_TEMPLATE_CODE=
# 사전 등록된 발신번호
BIZGO_SENDER_NUMBER=
# true일 때만 실제 발송
BIZGO_SEND_ENABLED=false
